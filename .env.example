# Bootstrap identity only. Connectivity and SWR_LOCAL_DEV_BOOTSTRAP: runtime/config/settings.py
# Load this file with SWR_LOAD_DOTENV=1 (local dev). Production uses SRM/Kubernetes-injected env.

# SWR_LOAD_DOTENV=1

SWR_RISK_GRPC_TARGET=127.0.0.1:51051
SWR_MARKET_DATA_REDIS_URL=redis://127.0.0.1:6379/

DEPLOYMENT_ID=25831484-fe6c-4af5-ae9b-7f35a8067363
RUNTIME_ID=25831484-fe6c-4af5-ae9b-7f35a8067363
STRATEGY_DEPLOYMENT_SERVICE_BASE_URL=http://localhost:5010
STRATEGY_RUNTIME_MANAGER_BASE_URL=http://127.0.0.1:8080

# Wall-clock interval (seconds) between periodic SRM status heartbeats.
SWR_HEARTBEAT_INTERVAL_SECONDS=30

# When true, print control-plane stdout lines for heartbeat/status posts to SRM.
SWR_HEARTBEAT_LOG_ENABLED=true
